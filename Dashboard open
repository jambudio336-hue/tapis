Dashboard: buka http://127.0.0.1:8787, isi token dari .env.
# daftarkan target
curl -s localhost:8787/api/v1/targets \
  -H "Authorization: Bearer $TAPIS_TOKEN" \
  -H 'Content-Type: application/json' \
  -d '{"msisdn":"+6281234567890","legal_basis":"ITE_PP71"}'

# ingest IRI
curl -s localhost:8787/api/v1/targets/<id>/events \
  -H "Authorization: Bearer $TAPIS_TOKEN" \
  -H 'Content-Type: application/json' \
  -d '{"jenis":"SIP_INVITE","payload":{"nomor_tujuan":"+62899"}}'

# lapor Cell ID
curl -s localhost:8787/api/v1/targets/<id>/cell \
  -H "Authorization: Bearer $TAPIS_TOKEN" \
  -H 'Content-Type: application/json' \
  -d '{"mnc":"10","lac":"1234","cid":"56789"}'

# verifikasi integritas
curl -s localhost:8787/api/v1/chain/<id>/verify -H "Authorization: Bearer $TAPIS_TOKEN"


