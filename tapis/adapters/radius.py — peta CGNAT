from __future__ import annotations

import socket
import struct
from dataclasses import dataclass, field
from datetime import datetime, timezone

AKUN = 4
ATTR = {1: "user_name", 4: "nas_ip", 5: "nas_port", 8: "framed_ip", 31: "calling_station_id",
        40: "acct_status", 44: "acct_session_id", 55: "event_timestamp", 87: "nas_port_id"}
STATUS = {1: "start", 2: "stop", 3: "interim"}


class RadiusRusak(ValueError):
    pass


@dataclass
class Sesi:
    user_name: str | None = None
    nas_ip: str | None = None
    nas_port: int | None = None
    framed_ip: str | None = None
    calling_station_id: str | None = None
    acct_status: str | None = None
    acct_session_id: str | None = None
    nas_port_id: str | None = None
    pada: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())

    def publik(self):
        if not self.framed_ip:
            return None
        port = self.nas_port
        if self.nas_port_id and ":" in self.nas_port_id:
            try:
                port = int(self.nas_port_id.rsplit(":", 1)[1])
            except ValueError:
                pass
        return (self.framed_ip, port) if port is not None else None


def parse(paket: bytes) -> Sesi:
    if len(paket) < 20:
        raise RadiusRusak("paket terlalu pendek")
    kode, _i, panjang = struct.unpack("!BBH", paket[:4])
    if kode != AKUN:
        raise RadiusRusak(f"bukan Accounting-Request (kode {kode})")
    if panjang > len(paket):
        raise RadiusRusak("panjang tidak konsisten")
    sesi = Sesi()
    i = 20
    while i + 2 <= panjang:
        tipe, ln = paket[i], paket[i + 1]
        if ln < 2 or i + ln > panjang:
            break
        nilai = paket[i + 2:i + ln]
        nama = ATTR.get(tipe)
        if nama:
            if tipe == 40 and nilai:
                setattr(sesi, nama, STATUS.get(nilai[0]))
            elif tipe in (8, 4) and len(nilai) == 4:
                setattr(sesi, nama, socket.inet_ntoa(nilai))
            elif tipe == 5 and len(nilai) == 4:
                setattr(sesi, nama, struct.unpack("!I", nilai)[0])
            else:
                setattr(sesi, nama, nilai.decode("utf-8", "replace"))
        i += ln
    return sesi
