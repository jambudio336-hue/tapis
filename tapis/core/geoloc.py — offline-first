from __future__ import annotations

import httpx

from .. import config
from . import cellres

OPENCELLID = "https://opencellid.org/cell/get"


async def dari_cell(mcc: str, mnc: str, lac: str, cid: str) -> dict | None:
    """Lokal dulu. API hanya penambah presisi."""
    lokal = cellres.resolve(mcc, mnc, lac, cid)
    if lokal and lokal["sumber"] != "centroid":
        return lokal

    if config.OPENCELLID_KEY:
        try:
            async with httpx.AsyncClient(timeout=8) as c:
                r = await c.get(
                    OPENCELLID,
                    params={"key": config.OPENCELLID_KEY, "mcc": mcc, "mnc": mnc,
                            "lac": lac, "cellid": cid, "format": "json"},
                )
                if r.status_code == 200 and "lat" in r.json():
                    d = r.json()
                    hasil = {"lat": d["lat"], "lon": d["lon"],
                             "akurasi": d.get("range", 0) or 0, "sumber": "opencellid"}
                    cellres.belajar(mcc, mnc, lac, cid, hasil["lat"], hasil["lon"], hasil["akurasi"])
                    return hasil
        except (httpx.HTTPError, ValueError):
            pass

    return lokal
