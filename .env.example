# Token akses API & dashboard. Ganti sebelum dipakai.
TAPIS_TOKEN=ganti-token-ini

# Lokasi database SQLite
TAPIS_DB=./data/tapis.db

# Direktori penyimpanan audio
TAPIS_AUDIO_DIR=./data/audio

# Kunci API opsional
OPENCELLID_KEY=
GOOGLE_GEOLOC_KEY=

# Retensi default (hari)
RETENTION_DAYS=30

# Batas peringatan TTL warrant (hari)
TTL_WARN_DAYS=3

HOST=127.0.0.1
PORT=8787
